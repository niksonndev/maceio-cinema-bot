# OMDb_API_KEY=
# TMDB_API_KEY=

# Health server (Render sets PORT automatically)
# PORT=10000

# WhatsApp session SQLite path (ephemeral on Render Free)
# SESSION_PATH=data/whatsapp.db

# Set automatically on Render; enables keep-alive ping every 10 minutes
# RENDER_EXTERNAL_URL=
