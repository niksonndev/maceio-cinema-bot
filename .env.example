# Telegram (obrigatório para bot:listen / Lambda)
# Crie um bot em https://t.me/BotFather e use o token abaixo.
TELEGRAM_BOT_TOKEN=

# Opcional: notas IMDb e Rotten Tomatoes (via OMDb)
# Obtenha uma chave gratuita em https://www.omdbapi.com/apikey.aspx
# OMDb_API_KEY=

# Opcional: nota TMDb (fallback quando OMDb não retorna nada)
# Crie uma API key em https://www.themoviedb.org/settings/api
# TMDB_API_KEY=

# Local polling only (npm run bot:listen) — Express health check
# PORT=10000

# SAM / Lambda (injetados pelo template.yaml em produção)
# Quando S3_BUCKET está definido, cache e prefs usam S3 em vez de data/*.json
# S3_BUCKET=
# CACHE_KEY=cache.json
# PREFS_KEY=prefs.json
# WEBHOOK_URL=   # SAM (FetchFunction only): ${HttpApi.ApiEndpoint}/prod/webhook
# AWS_ENDPOINT_URL=   # só testes (LocalStack), ex.: http://localhost:4566
