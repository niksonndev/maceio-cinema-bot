# Telegram (required for bot:listen / Lambda)
# Create a bot at https://t.me/BotFather and paste the token below.
TELEGRAM_BOT_TOKEN=

# Optional: IMDb and Rotten Tomatoes ratings (via OMDb)
# Get a free key at https://www.omdbapi.com/apikey.aspx
# OMDb_API_KEY=

# Optional: TMDb rating (fallback when OMDb returns nothing)
# Create an API key at https://www.themoviedb.org/settings/api
# TMDB_API_KEY=

# Local polling only (npm run bot:listen) — Express health check
# PORT=10000

# SAM / Lambda (injected by template.yaml in production)
# When S3_BUCKET is set, cache and prefs use S3 instead of data/*.json
# S3_BUCKET=
# CACHE_KEY=cache.json
# PREFS_KEY=prefs.json
# WEBHOOK_URL=   # SAM (FetchFunction only): ${HttpApi.ApiEndpoint}/prod/webhook
# AWS_ENDPOINT_URL=   # tests only (LocalStack), e.g. http://localhost:4566
